# ------------------------------------------------------------------
# MOJATECH website environment variables
# Copy this file to .env.local and fill in real values.
# The site builds and runs without any of these — they only unlock
# optional integrations.
# ------------------------------------------------------------------

# Public URL of the deployed site (used for canonical URLs, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Where the contact form should POST project requests.
# Point this at any form endpoint (Formspree, Basin, Resend API route,
# a custom webhook, etc). If left empty, the form tells visitors to use
# the direct call / WhatsApp / email options instead of pretending to send.
CONTACT_WEBHOOK_URL=
