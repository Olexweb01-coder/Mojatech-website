# MOJATECH website and admin app: settings.
# Copy into .env.local (your computer) and Vercel → Settings → Environment Variables.
# Never commit real values. Everything except the database is optional: a missing
# key simply switches that feature off, with a message in the admin saying what to add.

# ---- Database (Neon). The live site uses the production branch; your computer
#      should use a separate "dev" branch so testing never touches real data.
DATABASE_URL=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL_POOLED is also accepted (Vercel's Neon integration adds it).

# ---- Admin sign-in
# Master password: the way in before accounts exist, and the way back in if locked out.
ADMIN_PASSWORD=
# Any long random text, different from the password. Anonymises IP addresses for the
# spam and sign-in limits.
ADMIN_SECRET=

# ---- Arik, the assistant (any one is enough; more means fewer limits). All free.
GROQ_API_KEY=            # console.groq.com/keys      fast replies, web search, voice typing
GEMINI_API_KEY=          # aistudio.google.com/apikey photos and long documents
MISTRAL_API_KEY=         # console.mistral.ai         long writing (optional)
OPENROUTER_API_KEY=      # openrouter.ai/keys         extra free models, natural voice
FISH_API_KEY=            # fish.audio/app/api-keys    natural voice, directly (optional)
# ARIK_VOICE_ID=         # a Fish Audio voice to use instead of the default
# Model names can be changed without code if a service renames them:
# ARIK_GROQ_FAST, ARIK_GROQ_LIGHT, ARIK_GROQ_WEB, ARIK_GEMINI_FLASH, ARIK_GEMINI_LITE,
# ARIK_MISTRAL, ARIK_OPENROUTER_MODEL, ARIK_WHISPER, ARIK_TTS_MODEL

# ---- Pictures (Cloudflare Workers AI, free daily allowance)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=    # token with the "Workers AI" permission
# ARIK_IMAGE_DAILY=20    # pictures per day for the whole team
# ARIK_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b

# ---- Reminders, follow-up nudges and the morning briefing
# Random text. A free scheduler (cron-job.org) calls /api/cron/tick every 5 minutes
# with the header  Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
# Phone alert keys are created automatically; set these only to use your own.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:info@mojatechelectrical.com

# ---- Search engines
# Lets a published product or project tell Bing about itself straight away.
INDEXNOW_KEY=ec41a28b82af092dc19a2e1464742fd1
