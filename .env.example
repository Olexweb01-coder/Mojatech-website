# Copy these into Vercel: Settings → Environment Variables. Never commit real values.

# The Neon database (Vercel → Storage, or neon.tech → your project → Connection string)
DATABASE_URL=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# The password for mojatechelectrical.com/admin. Choose a long one.
ADMIN_PASSWORD=

# Any long random text; it signs the admin's sign-in cookie.
ADMIN_SECRET=

# Lets a published product tell Bing about itself straight away.
INDEXNOW_KEY=ec41a28b82af092dc19a2e1464742fd1
